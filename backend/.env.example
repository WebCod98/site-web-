# SCULPT'AURA — Backend (Express API) environment
# Copy to .env and fill in the values.

PORT=4000
NODE_ENV=development

# Public base URLs (used to build payment redirect / notify links).
PUBLIC_API_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# --- Supabase --------------------------------------------------------------
# The SERVICE ROLE key bypasses RLS. Server-side only, never exposed.
# Leave empty to run in DEMO mode (orders kept in memory).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) --------------------------------------------------------
# Leave empty to run in DEMO mode (emails are logged, not sent).
RESEND_API_KEY=

# --- Payment provider ------------------------------------------------------
# "demo"     → self-contained simulator, no account needed (default).
# "cinetpay" → CinetPay (Mobile Money / cards, Cameroon). Requires keys below.
PAYMENT_PROVIDER=demo

# CinetPay credentials (only needed when PAYMENT_PROVIDER=cinetpay)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# Optional: shared secret for webhook signature checks (provider-dependent)
PAYMENT_WEBHOOK_SECRET=
