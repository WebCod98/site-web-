# SCULPT'AURA — Backend (Express API) environment
# Copy to .env and fill in the values.

PORT=4000
NODE_ENV=development

# Public storefront origin(s), comma-separated, used for CORS.
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Supabase — the SERVICE ROLE key bypasses RLS. Server-side only, never exposed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email (order confirmations, newsletter opt-in).
RESEND_API_KEY=

# Payment provider webhook signing secret (verifies incoming webhooks).
PAYMENT_WEBHOOK_SECRET=
