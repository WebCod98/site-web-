# SCULPT'AURA — Frontend (public storefront) environment
# Copy this file to .env.local and fill in the values.

# Public Supabase project (safe to expose — protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Express backend (webhooks, heavy requests, invoices)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical site URL, used for SEO metadata and sitemaps
NEXT_PUBLIC_SITE_URL=http://localhost:3000
