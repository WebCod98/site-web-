# SCULPT'AURA — Admin (Super Admin PWA) environment
# Copy to .env.local and fill in the values.

# Supabase project (anon key; admin access is gated by profiles.is_admin via RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Express backend (invoices, heavy operations)
NEXT_PUBLIC_API_URL=http://localhost:4000
